# Backend production configuration. Values must be set in Render as well.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
JWT_SECRET=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
USER_STORE_ENCRYPTION_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail'de uygulama sifresi kullanin; normal hesap sifresini kullanmayin.
SMTP_PASSWORD=
# Resend ile e-posta gonderimi (birincil kanal; yoksa SMTP kullanilir).
# Anahtari https://resend.com/api-keys adresinden olusturun, degeri buraya YAZMAYIN.
RESEND_API_KEY=
# Domain dogrulanmadan varsayilan (onboarding) adres SADECE Resend hesap
# e-postasina gonderir. Ornek: Hedefime Nasil Giderim <mail@ornek.com>
RESEND_FROM=
